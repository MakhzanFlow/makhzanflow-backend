generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model billing_history {
  id                 String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id         String             @db.Uuid
  plan_id            String             @db.Uuid
  amount             Decimal            @db.Decimal(10, 2)
  status             String             @db.VarChar(50)
  billing_date       DateTime           @default(now()) @db.Timestamptz(6)
  invoice_url        String?
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  companies          companies          @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscription_plans subscription_plans @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id], map: "idx_billing_history_company")
}

model companies {
  id                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                  String                 @db.VarChar(255)
  logo_url              String?
  invite_code           String?                @unique @db.VarChar(50)
  created_at            DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?              @default(now()) @db.Timestamptz(6)
  deleted_at            DateTime?              @db.Timestamptz(6)
  activity_logs         activity_logs[]
  billing_history       billing_history[]
  company_members       company_members[]
  company_subscriptions company_subscriptions?
  customers             customers[]
  invoices              invoices[]
  inventory_logs        inventory_logs[]
  join_requests         join_requests[]
  payments              payments[]
  products              products[]

  @@index([deleted_at], map: "idx_companies_deleted_at")
}

model company_members {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id  String      @db.Uuid
  user_id     String      @db.Uuid
  role        member_role @default(member)
  permissions Json        @default("{}")
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @default(now()) @db.Timestamptz(6)
  companies   companies   @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([company_id, user_id])
  @@index([company_id], map: "idx_company_members_company")
  @@index([user_id], map: "idx_company_members_user")
}

model company_subscriptions {
  id                   String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id           String              @unique @db.Uuid
  plan_id              String              @db.Uuid
  status               subscription_status @default(trial)
  trial_ends_at        DateTime?           @db.Timestamptz(6)
  current_period_start DateTime            @default(now()) @db.Timestamptz(6)
  current_period_end   DateTime            @db.Timestamptz(6)
  created_at           DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?           @default(now()) @db.Timestamptz(6)
  companies            companies           @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscription_plans   subscription_plans  @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([plan_id], map: "idx_company_subscriptions_plan")
}

model customers {
  id              String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id      String     @db.Uuid
  name            String     @db.VarChar(255)
  phone           String?    @db.VarChar(50)
  email           String?    @db.VarChar(255)
  address         String?
  opening_balance Decimal    @default(0.00) @db.Decimal(10, 2)
  image_url       String?
  created_at      DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?  @default(now()) @db.Timestamptz(6)
  companies       companies       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoices        invoices[]

  @@index([company_id], map: "idx_customers_company")
  @@index([company_id, name], map: "idx_customers_company_name")
  @@index([email], map: "idx_customers_email")
  @@index([phone], map: "idx_customers_phone")
}

model inventory_logs {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id     String          @db.Uuid
  product_id     String          @db.Uuid
  user_id        String          @db.Uuid
  action         log_action_type
  quantity       Int
  previous_stock Int
  new_stock      Int
  notes          String?
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  companies      companies       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products       products        @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([company_id], map: "idx_inventory_logs_company")
  @@index([product_id], map: "idx_inventory_logs_product")
  @@index([user_id], map: "idx_inventory_logs_user")
  @@index([company_id, created_at], map: "idx_inventory_logs_company_created")
}

model invoice_items {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  invoice_id  String    @db.Uuid
  product_id  String?   @db.Uuid
  quantity    Int
  unit_price  Decimal   @db.Decimal(10, 2)
  total_price Decimal   @db.Decimal(10, 2)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  invoices    invoices  @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products? @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@index([invoice_id], map: "idx_invoice_items_invoice")
  @@index([product_id], map: "idx_invoice_items_product")
}

model invoices {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id      String          @db.Uuid
  customer_id     String?         @db.Uuid
  invoice_number  String          @db.VarChar(100)
  status          invoice_status  @default(pending)
  total_amount    Decimal         @default(0.00) @db.Decimal(10, 2)
  discount_amount Decimal         @default(0.00) @db.Decimal(10, 2)
  tax_amount      Decimal         @default(0.00) @db.Decimal(10, 2)
  due_date        DateTime?       @db.Timestamptz(6)
  created_at      DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?       @default(now()) @db.Timestamptz(6)
  user_id         String?         @db.Uuid
  users           users?          @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  invoice_items   invoice_items[]
  companies       companies       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customers       customers?      @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  payments        payments[]

  @@unique([company_id, invoice_number])
  @@index([company_id], map: "idx_invoices_company")
  @@index([customer_id], map: "idx_invoices_customer")
  @@index([status], map: "idx_invoices_status")
  @@index([created_at], map: "idx_invoices_created")
  @@index([company_id, created_at], map: "idx_invoices_company_created")
}

model join_requests {
  id         String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id String         @db.Uuid
  user_id    String         @db.Uuid
  status     request_status @default(pending)
  created_at DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at DateTime?      @default(now()) @db.Timestamptz(6)
  companies  companies      @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([company_id, user_id])

  @@index([company_id], map: "idx_join_requests_company")
  @@index([user_id], map: "idx_join_requests_user")
}

model payments {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id       String         @db.Uuid
  invoice_id       String         @db.Uuid
  amount           Decimal        @db.Decimal(10, 2)
  method           payment_method @default(cash)
  reference_number String?        @db.VarChar(100)
  notes            String?
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  companies        companies      @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoices         invoices       @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([company_id], map: "idx_payments_company")
  @@index([invoice_id], map: "idx_payments_invoice")
  @@index([created_at], map: "idx_payments_created")
  @@index([company_id, created_at], map: "idx_payments_company_created")
}

model products {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id     String           @db.Uuid
  name           String           @db.VarChar(255)
  sku            String?          @db.VarChar(100)
  barcode        String?          @db.VarChar(100)
  price          Decimal          @default(0.00) @db.Decimal(10, 2)
  stock          Int              @default(0)
  min_stock      Int              @default(0)
  image_url      String?
  expiry_date    DateTime?        @db.Date
  is_active      Boolean          @default(true)
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?        @default(now()) @db.Timestamptz(6)
  inventory_logs inventory_logs[]
  invoice_items  invoice_items[]
  companies      companies        @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([company_id, barcode])
  @@unique([company_id, sku])
  @@index([barcode], map: "idx_products_barcode")
  @@index([company_id], map: "idx_products_company")
  @@index([company_id, name], map: "idx_products_company_name")
  @@index([company_id, is_active], map: "idx_products_company_active")
}

model refresh_tokens {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique @db.VarChar(255)
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_refresh_tokens_user")
}

model subscription_plans {
  id                    String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                  String                  @db.VarChar(100)
  price                 Decimal                 @default(0.00) @db.Decimal(10, 2)
  interval_days         Int
  features              Json                    @default("{}")
  is_active             Boolean                 @default(true)
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  billing_history       billing_history[]
  company_subscriptions company_subscriptions[]
}

model users {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                String                @db.VarChar(255)
  email               String                @unique @db.VarChar(255)
  password_hash       String                @db.VarChar(255)
  is_verified         Boolean               @default(false)
  verified_at         DateTime?             @db.Timestamptz(6)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  activity_logs       activity_logs[]
  company_members     company_members[]
  inventory_logs      inventory_logs[]
  invoices            invoices[]
  join_requests       join_requests[]
  refresh_tokens      refresh_tokens[]
  verification_tokens verification_tokens[]

}

model verification_tokens {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique @db.VarChar(255)
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_verification_tokens_user")
}

model activity_logs {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id String   @db.Uuid
  user_id    String   @db.Uuid
  entity     String   @db.VarChar(50)
  entity_id  String?  @db.Uuid
  action     String   @db.VarChar(50)
  changes    Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  companies  companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([company_id, entity, entity_id])
  @@index([company_id, created_at])
}

enum invoice_status {
  pending
  paid
  partially_paid
  canceled
}

enum log_action_type {
  add
  remove
  adjust
  sale
  return
}

enum member_role {
  owner
  admin
  member
}

enum payment_method {
  cash
  card
  bank_transfer
  other
}

enum request_status {
  pending
  approved
  rejected
}

enum subscription_status {
  active
  trial
  expired
  canceled
}
