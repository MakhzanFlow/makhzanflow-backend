generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model billing_history {
  id                 String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id         String             @db.Uuid
  plan_id            String             @db.Uuid
  amount             Decimal            @db.Decimal(10, 2)
  status             String             @db.VarChar(50)
  billing_date       DateTime           @default(now()) @db.Timestamptz(6)
  invoice_url        String?
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  companies          companies          @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscription_plans subscription_plans @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model companies {
  id                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                  String                 @db.VarChar(255)
  logo_url              String?
  created_at            DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?              @default(now()) @db.Timestamptz(6)
  billing_history       billing_history[]
  company_members       company_members[]
  company_subscriptions company_subscriptions?
  customers             customers[]
  invoices              invoices[]
  join_requests         join_requests[]
  products              products[]
}

model company_members {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id  String      @db.Uuid
  user_id     String      @db.Uuid
  role        member_role @default(member)
  permissions Json        @default("{}")
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @default(now()) @db.Timestamptz(6)
  companies   companies   @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([company_id, user_id])
  @@index([company_id], map: "idx_company_members_company")
  @@index([user_id], map: "idx_company_members_user")
}

model company_subscriptions {
  id                   String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id           String              @unique @db.Uuid
  plan_id              String              @db.Uuid
  status               subscription_status @default(trial)
  trial_ends_at        DateTime?           @db.Timestamptz(6)
  current_period_start DateTime            @default(now()) @db.Timestamptz(6)
  current_period_end   DateTime            @db.Timestamptz(6)
  created_at           DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?           @default(now()) @db.Timestamptz(6)
  companies            companies           @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscription_plans   subscription_plans  @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model customers {
  id         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id String     @db.Uuid
  name       String     @db.VarChar(255)
  phone      String?    @db.VarChar(50)
  email      String?    @db.VarChar(255)
  address    String?
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at DateTime?  @default(now()) @db.Timestamptz(6)
  companies  companies  @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoices   invoices[]

  @@index([company_id], map: "idx_customers_company")
}

model inventory_logs {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  product_id     String          @db.Uuid
  user_id        String          @db.Uuid
  action         log_action_type
  quantity       Int
  previous_stock Int
  new_stock      Int
  notes          String?
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  products       products        @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_inventory_logs_product")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoice_items {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  invoice_id  String    @db.Uuid
  product_id  String?   @db.Uuid
  quantity    Int
  unit_price  Decimal   @db.Decimal(10, 2)
  total_price Decimal   @db.Decimal(10, 2)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  invoices    invoices  @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products? @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@index([invoice_id], map: "idx_invoice_items_invoice")
}

model invoices {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id      String          @db.Uuid
  customer_id     String?         @db.Uuid
  invoice_number  String          @db.VarChar(100)
  status          invoice_status  @default(pending)
  total_amount    Decimal         @default(0.00) @db.Decimal(10, 2)
  discount_amount Decimal         @default(0.00) @db.Decimal(10, 2)
  tax_amount      Decimal         @default(0.00) @db.Decimal(10, 2)
  due_date        DateTime?       @db.Timestamptz(6)
  created_at      DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?       @default(now()) @db.Timestamptz(6)
  invoice_items   invoice_items[]
  companies       companies       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customers       customers?      @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  payments        payments[]

  @@unique([company_id, invoice_number])
  @@index([company_id], map: "idx_invoices_company")
}

model join_requests {
  id         String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id String         @db.Uuid
  user_id    String         @db.Uuid
  status     request_status @default(pending)
  created_at DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at DateTime?      @default(now()) @db.Timestamptz(6)
  companies  companies      @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([company_id, user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  invoice_id       String         @db.Uuid
  amount           Decimal        @db.Decimal(10, 2)
  method           payment_method @default(cash)
  reference_number String?        @db.VarChar(100)
  notes            String?
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  invoices         invoices       @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([invoice_id], map: "idx_payments_invoice")
}

model products {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id     String           @db.Uuid
  name           String           @db.VarChar(255)
  sku            String?          @db.VarChar(100)
  barcode        String?          @db.VarChar(100)
  price          Decimal          @default(0.00) @db.Decimal(10, 2)
  cost           Decimal          @default(0.00) @db.Decimal(10, 2)
  stock          Int              @default(0)
  min_stock      Int              @default(0)
  is_active      Boolean          @default(true)
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?        @default(now()) @db.Timestamptz(6)
  inventory_logs inventory_logs[]
  invoice_items  invoice_items[]
  companies      companies        @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([company_id, barcode])
  @@unique([company_id, sku])
  @@index([barcode], map: "idx_products_barcode")
  @@index([company_id], map: "idx_products_company")
}

model subscription_plans {
  id                    String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                  String                  @db.VarChar(100)
  price                 Decimal                 @default(0.00) @db.Decimal(10, 2)
  interval_days         Int
  features              Json                    @default("{}")
  is_active             Boolean                 @default(true)
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  billing_history       billing_history[]
  company_subscriptions company_subscriptions[]
}

enum invoice_status {
  pending
  paid
  partially_paid
  canceled
}

enum log_action_type {
  add
  remove
  adjust
  sale
  return
}

enum member_role {
  owner
  admin
  member
}

enum payment_method {
  cash
  card
  bank_transfer
  other
}

enum request_status {
  pending
  approved
  rejected
}

enum subscription_status {
  active
  trial
  expired
  canceled
}
